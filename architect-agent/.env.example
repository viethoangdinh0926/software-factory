# Architect Agent — copy to .env and adjust

HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Shared LLM knobs (used by every provider below)
LLM_TEMPERATURE=0.3

# --- Active: stub (offline deterministic LLM, no API key) ---
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Dell AIA Gateway ---
# LLM_MODEL=
# LLM_PROVIDER=
# AIA_GATEWAY_CLIENT_ID=
# AIA_GATEWAY_CLIENT_SECRET=
# AIA_GATEWAY_BASE_URL=

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Downstream System Manager agent (A2A) ---
# When set, each design approval sends the design package markdown to this peer.
# Leave unset to queue packages under backend/data/handoffs/ until the agent exists.
# SYSTEM_MANAGER_AGENT_URL=http://127.0.0.1:8090
