# Architect Agent — copy to .env and adjust

HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Shared LLM knobs (used by every provider below)
LLM_TEMPERATURE=0.3

# --- Active: stub (offline deterministic LLM, no API key) ---
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
