# Architect Agent — copy to .env and adjust

HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Shared LLM knobs (used by every provider below)
LLM_TEMPERATURE=0.3

# SSL verification for HTTP clients (true/false)
SSL_VERIFY=true

# --- Active: stub (offline deterministic LLM, no API key) ---
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Dell RealLLM proxy---
# LLM_PROVIDER=
# LLM_MODEL=
# REALLM_API_KEY=
# REALLM_BASE_URL=

# --- Dell AIA Gateway ---
# LLM_MODEL=
# LLM_PROVIDER=
# AIA_GATEWAY_CLIENT_ID=
# AIA_GATEWAY_CLIENT_SECRET=
# AIA_GATEWAY_BASE_URL=

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Downstream Orchestrator agent (A2A) ---
# When set, each design approval sends the design package markdown to this peer.
# Leave unset to queue packages under backend/data/handoffs/ until the agent exists.
# ORCHESTRATOR_AGENT_URL=http://127.0.0.1:8090
# SYSTEM_MANAGER_AGENT_URL is accepted as a deprecated alias.

# --- Long-session context budgets (approx tokens) ---
# CONTEXT_HISTORY_MAX_TOKENS=1800
# CONTEXT_HISTORY_MAX_TURNS=12
# CONTEXT_SPEC_SOFT_TOKENS=5500
# CONTEXT_SPEC_HARD_TOKENS=9000
# CONTEXT_SPEC_COMPACT_TARGET_TOKENS=4000
# CONTEXT_JUSTIFICATION_SOFT_TOKENS=3500
# CONTEXT_JUSTIFICATION_HARD_TOKENS=6000
# CONTEXT_JUSTIFICATION_COMPACT_TARGET_TOKENS=2500

# --- Market evaluation (after first spec approval) ---
# Web search via DuckDuckGo. Automatically skipped when LLM_PROVIDER=stub.
# MARKET_RESEARCH_WEB_ENABLED=true
