# Engineer Agent — copy to .env and adjust

HOST=127.0.0.1
PORT=8091
PUBLIC_BASE_URL=http://127.0.0.1:8091

LLM_TEMPERATURE=0.3
SSL_VERIFY=true

# --- Execution ---
# BACKGROUND_EXECUTE=true
# GIT_EXECUTE_ENABLED=true
# Hand each plan item to the local Pi coding-agent SDK (tests → implement → evaluate).
# PI_CODER_ENABLED=true
# PI_NODE_BIN=node
# PI_CODER_MAX_ROUNDS=5
# PI_CODER_TIMEOUT_SECONDS=900

# --- Active: stub (offline deterministic LLM, no API key) ---
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Dell RealLLM proxy---
# LLM_PROVIDER=
# LLM_MODEL=
# REALLM_API_KEY=
# REALLM_BASE_URL=

# --- Dell AIA Gateway ---
# LLM_MODEL=
# LLM_PROVIDER=
# AIA_GATEWAY_CLIENT_ID=
# AIA_GATEWAY_CLIENT_SECRET=
# AIA_GATEWAY_BASE_URL=

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
